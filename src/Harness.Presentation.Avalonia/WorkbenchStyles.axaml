<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit">
  <Style Selector="Button.command">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="Background" Value="{DynamicResource Harness.Raised}" />
  </Style>
  <Style Selector="Button.command:pointerover">
    <Setter Property="Background" Value="{DynamicResource Harness.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.BorderStrong}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Harness.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.AccentStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.Window}" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Harness.AccentStrong}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="34" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon:pointerover">
    <Setter Property="Background" Value="{DynamicResource Harness.Hover}" />
  </Style>
  <Style Selector="Button.tree-file">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tree-file:pointerover">
    <Setter Property="Background" Value="{DynamicResource Harness.Hover}" />
  </Style>
  <Style Selector="TextBox.workspace-input">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="ComboBox.toolbar-input">
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="AutoCompleteBox.toolbar-input">
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Padding" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
  </Style>
  <Style Selector="Border.message-card">
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
  </Style>
  <Style Selector="Border.message-card.user">
    <Setter Property="Background" Value="{DynamicResource Harness.AccentSoft}" />
  </Style>
  <Style Selector="Border.workflow-card">
    <Setter Property="Padding" Value="13,10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="Background" Value="{DynamicResource Harness.Raised}" />
  </Style>
  <Style Selector="Border.workflow-state">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
  </Style>
  <Style Selector="Border.workflow-state > TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
  </Style>
  <Style Selector="Border.workflow-state.success">
    <Setter Property="Background" Value="{DynamicResource Harness.AccentSoft}" />
  </Style>
  <Style Selector="Border.workflow-state.success > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Harness.AccentStrong}" />
  </Style>
  <Style Selector="Border.workflow-state.attention">
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Warning}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.workflow-state.attention > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Harness.Warning}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.AccentStrong}" />
    <Setter Property="LetterSpacing" Value="1.1" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
  </Style>

  <!-- Command palette surface. -->
  <Style Selector="Window.palette">
    <Setter Property="Background" Value="{DynamicResource Harness.Header}" />
  </Style>
  <Style Selector="ListBox.palette-results">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.palette-results ListBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.palette-results ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Harness.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.palette-results ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Harness.Hover}" />
  </Style>
  <Style Selector="Button.palette-command">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.palette-command:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Searchable application settings. -->
  <Style Selector="Window.settings">
    <Setter Property="Background" Value="{DynamicResource Harness.Window}" />
  </Style>
  <Style Selector="Border.settings-navigation">
    <Setter Property="Padding" Value="20" />
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.settings-page">
    <Setter Property="Padding" Value="32,26" />
    <Setter Property="Background" Value="{DynamicResource Harness.Editor}" />
  </Style>
  <Style Selector="ListBox.settings-categories">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.settings-categories ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.settings-categories ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Harness.AccentSoft}" />
  </Style>

  <!-- Command bar: the visible, discoverable entry point to the command palette. -->
  <Style Selector="Button.command-bar">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
  </Style>
  <Style Selector="Button.command-bar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Harness.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.BorderStrong}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.BorderStrong}" />
    <Setter Property="Background" Value="{DynamicResource Harness.Raised}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextDim}" />
  </Style>

  <!-- Compact list rows and status chips used by the framework inspector. -->
  <Style Selector="Border.card.row">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Border.card.attention">
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Warning}" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Harness.AccentSoft}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.AccentStrong}" />
  </Style>
  <Style Selector="TextBlock.attention">
    <Setter Property="Foreground" Value="{DynamicResource Harness.Warning}" />
  </Style>

  <!-- Source documents: compact IDE chrome around the real AvaloniaEdit surface. -->
  <Style Selector="Border.editor-toolbar">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.editor-context">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
    <Setter Property="Margin" Value="8,0" />
  </Style>
  <Style Selector="Border.editor-access">
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Harness.Raised}" />
  </Style>
  <Style Selector="Border.editor-access > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
  </Style>
  <Style Selector="Border.editor-access.editable">
    <Setter Property="Background" Value="{DynamicResource Harness.AccentSoft}" />
  </Style>
  <Style Selector="Border.editor-access.editable > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Harness.AccentStrong}" />
  </Style>
  <Style Selector="Border.editor-access.truncated">
    <Setter Property="Background" Value="{DynamicResource Harness.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Warning}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.editor-access.truncated > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Harness.Warning}" />
  </Style>
  <Style Selector="Button.editor-action">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
  </Style>
  <Style Selector="Button.editor-action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Harness.Hover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Harness.TextPrimary}" />
  </Style>
  <Style Selector="Button.editor-action:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="avaloniaEdit|TextEditor.source-editor">
    <Setter Property="Background" Value="{DynamicResource Harness.Editor}" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextPrimary}" />
  </Style>
  <Style Selector="Border.editor-status-surface">
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Grid.editor-statusbar">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Margin" Value="10,0" />
  </Style>
  <Style Selector="Grid.editor-statusbar TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
  </Style>
  <Style Selector="Border.semantic-insight">
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.BorderStrong}" />
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #48000000" />
  </Style>

  <!-- Application identity mark in the header bar. -->
  <Style Selector="Border.app-mark">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource Harness.Accent}" />
  </Style>
  <Style Selector="Border.app-mark > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Harness.Window}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Header control cluster: related inputs read as one affordance, not loose fields. -->
  <Style Selector="Border.cluster">
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
  </Style>
  <Style Selector="Border.cluster TextBlock.cluster-label">
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="6,0,2,0" />
  </Style>

  <!-- Segmented control: one visible choice out of a small closed set. -->
  <Style Selector="Border.segmented">
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
  </Style>
  <Style Selector="ToggleButton.segment">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
  </Style>
  <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Harness.Hover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Harness.TextPrimary}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Harness.Accent}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Harness.Window}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.segment:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Harness.AccentStrong}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Harness.Window}" />
  </Style>

  <!-- Diff rows. Colour carries the change kind, so the tokens must stay semantic. -->
  <Style Selector="Border.diff-toolbar">
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Harness.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.diff-surface">
    <Setter Property="Background" Value="{DynamicResource Harness.Editor}" />
  </Style>
  <Style Selector="Border.diff-line">
    <Setter Property="MinHeight" Value="18" />
  </Style>
  <Style Selector="Border.diff-line.added">
    <Setter Property="Background" Value="{DynamicResource Harness.DiffAddBackground}" />
  </Style>
  <Style Selector="Border.diff-line.removed">
    <Setter Property="Background" Value="{DynamicResource Harness.DiffRemoveBackground}" />
  </Style>
  <Style Selector="Border.diff-line.file-header">
    <Setter Property="Background" Value="{DynamicResource Harness.Raised}" />
  </Style>
  <Style Selector="Border.diff-line.hunk-header">
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
  </Style>
  <Style Selector="Border.diff-line.absent">
    <Setter Property="Background" Value="{DynamicResource Harness.Panel}" />
  </Style>
  <Style Selector="Border.diff-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Harness.Border}" />
  </Style>
  <Style Selector="TextBlock.diff-text">
    <Setter Property="FontFamily" Value="Cascadia Code,JetBrains Mono,Consolas,Menlo,monospace" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.diff-text.added">
    <Setter Property="Foreground" Value="{DynamicResource Harness.DiffAddText}" />
  </Style>
  <Style Selector="TextBlock.diff-text.removed">
    <Setter Property="Foreground" Value="{DynamicResource Harness.DiffRemoveText}" />
  </Style>
  <Style Selector="TextBlock.diff-text.meta">
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.diff-text.header">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.diff-gutter">
    <Setter Property="FontFamily" Value="Cascadia Code,JetBrains Mono,Consolas,Menlo,monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Width" Value="52" />
    <Setter Property="Padding" Value="0,0,10,0" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Foreground" Value="{DynamicResource Harness.TextDim}" />
  </Style>
</Styles>
