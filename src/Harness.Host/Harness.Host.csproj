<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Xml" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <ProjectReference Include="../Harness.DataAccess/Harness.DataAccess.csproj" />
    <ProjectReference Include="../Harness.BusinessLogic/Harness.BusinessLogic.csproj" />
    <ProjectReference Include="../Harness.Presentation.Avalonia/Harness.Presentation.Avalonia.csproj" />
    <ProjectReference Include="../Harness.Presentation.Terminal/Harness.Presentation.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="harness.xml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harness.Host.Tests" />
  </ItemGroup>

  <Target Name="ExcludeRoslynBuildHostFromSingleFile"
          BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('BuildHost-netcore/'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
